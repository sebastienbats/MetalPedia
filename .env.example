# ═══════════════════════════════════════════════════════════
# METALPEDIA - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# ═══════════════════════════════════════════════════════════
# Copiez ce fichier vers .env.local et remplissez les valeurs
# Commande : cp .env.example .env.local
#
# ⚠️ NE JAMAIS committer .env.local dans Git
# ⚠️ Les clés marquées [SERVER ONLY] ne doivent pas être exposées côté client
# ═══════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════
# 🌐 FRONTEND - NEXT.JS
# ═══════════════════════════════════════════════════════════

# URL publique du site (utilisée pour SEO, metadataBase, callbacks OAuth)
# Développement : http://localhost:3000
# Production : https://metalpedia.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mode d'environnement (défini automatiquement par Next.js)
# NODE_ENV=development


# ═══════════════════════════════════════════════════════════
# 🗄️ SUPABASE - BASE DE DONNÉES & AUTH
# ═══════════════════════════════════════════════════════════
# Récupérez ces valeurs depuis : https://supabase.com/dashboard
# Project Settings → API

# URL de votre projet Supabase (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijk.supabase.co

# Clé anonyme (safe to expose - protégée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBsYWNlaG9sZGVyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MDAwMDAwMDB9.placeholder

# ⚠️ [SERVER ONLY] Clé service role - NE JAMAIS exposer côté client
# Contourne toutes les politiques RLS - à utiliser uniquement dans les Route Handlers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBsYWNlaG9sZGVyIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTcwMDAwMDAwMH0.placeholder


# ═══════════════════════════════════════════════════════════
# 🤖 ML SERVICE - MICROSERVICE PYTHON FASTAPI
# ═══════════════════════════════════════════════════════════

# URL du microservice ML (recommandations, embeddings Spotify)
# Développement : http://localhost:8000
# Production : https://metalpedia-ml.up.railway.app
NEXT_PUBLIC_ML_SERVICE_URL=http://localhost:8000


# ═══════════════════════════════════════════════════════════
# 🎵 SPOTIFY WEB API
# ═══════════════════════════════════════════════════════════
# Récupérez ces valeurs depuis : https://developer.spotify.com/dashboard
# Créez une app avec "Web API" activé

# ⚠️ [SERVER ONLY] Utilisé uniquement par le ML Service Python
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# ⚠️ [SERVER ONLY] Ne jamais exposer côté client
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here


# ═══════════════════════════════════════════════════════════
# 🎨 OPENAI API - GÉNÉRATION DE LOGOS IA
# ═══════════════════════════════════════════════════════════
# Récupérez votre clé depuis : https://platform.openai.com/api-keys
# Utilisé pour la génération de logos de groupes via DALL-E/GPT-Image

# ⚠️ [SERVER ONLY] Ne jamais exposer côté client
OPENAI_API_KEY=sk-proj-placeholder-key-do-not-use


# ═══════════════════════════════════════════════════════════
# 🎤 SONGKICK API - CONCERTS
# ═══════════════════════════════════════════════════════════
# Récupérez votre clé depuis : https://www.songkick.com/developer
# Utilisé pour afficher les concerts à venir des groupes

# Clé API Songkick (peut être exposée si utilisée via proxy serveur)
SONGKICK_API_KEY=your_songkick_api_key_here
NEXT_PUBLIC_SONGKICK_API_KEY=your_key_here

# ═══════════════════════════════════════════════════════════
# 🎤 LASTFM API - BANDS
# ═══════════════════════════════════════════════════════════
# Clé API Last.fm (Gratuite : https://www.last.fm/api/account/create)
LASTFM_API_KEY=ta_cle_api_lastfm_ici

# ═══════════════════════════════════════════════════════════
# 📊 MONITORING - SENTRY
# ═══════════════════════════════════════════════════════════
# Récupérez votre DSN depuis : https://sentry.io
# Projet → Settings → Client Keys (DSN)

# DSN Sentry pour le tracking d'erreurs (safe to expose)
NEXT_PUBLIC_SENTRY_DSN=

# ⚠️ [SERVER ONLY] Auth token pour source maps upload (CI/CD uniquement)
SENTRY_AUTH_TOKEN=


# ═══════════════════════════════════════════════════════════
# ⚡ CACHE - UPSTASH REDIS
# ═══════════════════════════════════════════════════════════
# Récupérez ces valeurs depuis : https://upstash.com
# Utilisé pour le cache distribué en production (remplace le cache mémoire)

# ⚠️ [SERVER ONLY]
UPSTASH_REDIS_REST_URL=

# ⚠️ [SERVER ONLY]
UPSTASH_REDIS_REST_TOKEN=


# ═══════════════════════════════════════════════════════════
# 🔐 OAUTH - GITHUB (OPTIONNEL)
# ═══════════════════════════════════════════════════════════
# Récupérez ces valeurs depuis : https://github.com/settings/developers
# OAuth Apps → New OAuth App
# Callback URL : https://xxxxx.supabase.co/auth/v1/callback

# ⚠️ Configuré directement dans Supabase Dashboard → Authentication → Providers
# Ces variables sont pour référence si vous gérez OAuth hors Supabase
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════
# 🔐 OAUTH - GOOGLE (OPTIONNEL)
# ═══════════════════════════════════════════════════════════
# Récupérez ces valeurs depuis : https://console.cloud.google.com/apis/credentials
# Callback URL : https://xxxxx.supabase.co/auth/v1/callback

# ⚠️ Configuré directement dans Supabase Dashboard → Authentication → Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════
# 📈 ANALYTICS (OPTIONNEL)
# ═══════════════════════════════════════════════════════════

# Plausible Analytics (privacy-friendly)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=


# ═══════════════════════════════════════════════════════════
# 🚀 VERCEL (DÉPLOIEMENT)
# ═══════════════════════════════════════════════════════════
# Définies automatiquement par Vercel lors du déploiement
# Ne pas définir manuellement sauf cas spécifique

# VERCEL_ENV=production
# VERCEL_URL=metalpedia.vercel.app
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_MESSAGE=


# ═══════════════════════════════════════════════════════════
# 🐛 DEBUG & DÉVELOPPEMENT
# ═══════════════════════════════════════════════════════════

# Active les logs détaillés (true/false)
NEXT_PUBLIC_DEBUG_MODE=false

# Active le React Query Devtools en production (true/false)
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=false

# Désactive la gamification pour tests (true/false)
NEXT_PUBLIC_DISABLE_GAMIFICATION=false


# ═══════════════════════════════════════════════════════════
# 📧 EMAIL (OPTIONNEL - pour notifications)
# ═══════════════════════════════════════════════════════════

# Resend (email transactionnel)
RESEND_API_KEY=

# Email expéditeur pour les notifications
EMAIL_FROM=notifications@metalpedia.app


# ═══════════════════════════════════════════════════════════
# 🎮 FONCTIONNALITÉS EXPÉRIMENTALES
# ═══════════════════════════════════════════════════════════

# Active le mode offline avancé (true/false)
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true

# Active la Metal Map 3D (true/false)
NEXT_PUBLIC_ENABLE_METAL_MAP=true

# Active le générateur de logos IA (true/false)
NEXT_PUBLIC_ENABLE_AI_LOGO=true

# Limite de requêtes IA par jour (0 = illimité)
NEXT_PUBLIC_AI_DAILY_LIMIT=5
